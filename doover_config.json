{
    "pivot_control": {
        "name": "pivot_control",
        "display_name": "Pivot Control",
        "type": "PRO",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Start, stop, schedule and monitor a centre-pivot irrigator through its edge controller.",
        "icon_url": "https://cdn.jsdelivr.net/gh/getdoover/app-icons@3d5d1b37246278cfac11c00155f5e0b30f6ee5de/icons/pivot_control.png",
        "long_description": "README.md",
        "depends_on": [],
        "organisation_id": null,
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "export_notification_command": "export-notifications",
        "build_widget_command": "npm --prefix widget install && npm --prefix widget run build",
        "widget": "widget/assets/PivotControlWidget.js",
        "lambda_config": {
            "Environment": {},
            "Runtime": "python3.13",
            "Timeout": 60,
            "Handler": "src.pivot_control.handler",
            "MemorySize": 128,
            "Architectures": [
                "arm64"
            ]
        },
        "repository_url": "https://github.com/getdoover/pivot-control",
        "data_access": "read_write",
        "has_ui": true
    }
}
